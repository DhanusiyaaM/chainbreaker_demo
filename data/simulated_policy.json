            "Resource": [
              "arn:aws:s3:::prod-app-deployments",
              "arn:aws:s3:::prod-app-deployments/*"
            ]
          },
          {
            "Sid": "CloudFrontInvalidation",
            "Effect": "Allow",
            "Action": [
              "cloudfront:CreateInvalidation"
            ],
            "Resource": "arn:aws:cloudfront::123456789012:distribution/ABCDEFGHIJKLMN"
          }
        ]
      }
    }
  ],

  "inline_policies": []
}
