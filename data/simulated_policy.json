  "attached_policies": [
    {
      "PolicyName": "DeployToS3Policy",
      "PolicyArn": "arn:aws:iam::123456789012:policy/DeployToS3Policy",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "S3DeployAccess",
            "Effect": "Allow",
            "Action": [
              "s3:PutObject",
              "s3:GetObject",
              "s3:DeleteObject",
              "s3:ListBucket",
