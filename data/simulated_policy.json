{
  "_comment": "Simulated IAM permission policy — use as data/simulated_policy.json in ChainBreaker Mode B",
  "_note": "Role has s3:PutObject, s3:DeleteObject, s3:GetObject on prod-app-deployments",
  "_chainbreaker_expected": "Step 3 will flag: capability=DATA_TAMPERING, no versioning amplifies DELETE",

  "source": "simulated",
  "role_name": "github-deploy-role",
