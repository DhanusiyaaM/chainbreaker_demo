{
  "_comment": "Trust policy for the FIXED role (github-deploy-role-fixed)",
  "_note": "Sub claim restricted to main branch only AND environment gate",
  "_chainbreaker_expected": "Step 2 will flag: trust_risk=LOW (+8), branch restricted, no PRT trigger",

  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOIDCStrictBranch",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:DhanusiyaaM/chainbreaker_demo:ref:refs/heads/main",
          "token.actions.githubusercontent.com:environment": "production"
        }
      }
    }
  ]
}
